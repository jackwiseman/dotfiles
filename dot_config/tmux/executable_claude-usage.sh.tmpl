#!/usr/bin/env bash

# Claude Code usage (5h / weekly rate-limit %) for tmux status-right.
#
# Pure cache reader: ~/.claude/statusline-command.sh persists the rate_limits
# payload Claude Code pipes to it on every statusline render into CACHE.
# No credentials or network involved here. If Claude Code hasn't rendered a
# statusline within MAX_AGE the data is stale (the 5h window moves fast), so
# we print nothing rather than a misleading number.
# Fails silently on any error so the status bar stays clean.

MAX_AGE=3600
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/tmux/claude-usage.json"

# Rendered from .chezmoidata/colors.yaml at apply time -- tmux's conf-parse-time
# $vars (gruvbox.conf) aren't visible to a run-shell child process.
GREEN='{{ .gruvbox.bright_green }}'; YELLOW='{{ .gruvbox.bright_orange }}'
RED='{{ .gruvbox.bright_red }}'; GRAY='{{ .gruvbox.fg4 }}'

[[ -f "$CACHE" ]] || exit 0
command -v jq >/dev/null || exit 0

mtime="$(stat -f %m "$CACHE" 2>/dev/null || stat -c %Y "$CACHE" 2>/dev/null)" || exit 0
(( $(date +%s) - mtime < MAX_AGE )) || exit 0

color_for() {
    local u=$1
    if   (( u >= 90 )); then echo "$RED"
    elif (( u >= 70 )); then echo "$YELLOW"
    else                     echo "$GREEN"
    fi
}

read -r h5 d7 < <(jq -r '"\(.five_hour.used_percentage|floor) \(.seven_day.used_percentage|floor)"' "$CACHE" 2>/dev/null)
[[ "$h5" =~ ^[0-9]+$ && "$d7" =~ ^[0-9]+$ ]] || exit 0

printf '#[fg=%s]5h #[fg=%s]%s%%#[fg=%s] wk #[fg=%s]%s%%#[default]' \
    "$GRAY" "$(color_for "$h5")" "$h5" "$GRAY" "$(color_for "$d7")" "$d7"
exit 0
