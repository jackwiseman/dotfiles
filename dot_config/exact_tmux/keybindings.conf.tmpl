#
# keybindings
#

# remap prefix from 'C-b' to 'C-a'
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# change window split bind to (v)ertical and (s)plit
bind v split-window -h
bind s split-window -v
unbind '"'
unbind %

# disable tmux on shift-up for nested sessions, when not connected via ssh
if-shell -b '[ -z "$SSH_CONNECTION" ]' {
	bind -n S-Up \
		set prefix None\;\
		set key-table off\;\
		set status-right ' INACTIVE '\;\
		set status-right-style fg=$black,bg=$red\;\

	bind -T off S-Down \
	    set -u prefix \;\
	    set -u key-table \;\
	    set -u status-right-style \;\
	    set -u status-right
}

# add mouse support
set -g mouse on

# smart pane switching with awareness of Vim splits.
# see: https://github.com/christoomey/vim-tmux-navigator
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
tmux_version='$(tmux -V | sed -En "s/^tmux ([0-9]+(.[0-9]+)?).*/\1/p")'
if-shell -b '[ "$(echo "$tmux_version < 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\'  'select-pane -l'"
if-shell -b '[ "$(echo "$tmux_version >= 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\\\'  'select-pane -l'"

bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l

# skip confirmation to close a pane
bind-key x kill-pane

# agent dashboard: every window (any session, incl. claude_* popups) with a
# Claude state; Enter jumps (popup sessions re-open as popups)
# Colors come from the palette rather than gruvbox.conf's $vars: the format is
# single-quoted, and tmux only expands $vars inside double quotes.
bind a choose-tree -wZ -O time \
    -f '#{!=:#{@claude_state},}' \
    -F '#{?window_format,#{?#{==:#{@claude_state},working},#[fg={{ .gruvbox.bright_blue }}],#{?#{==:#{@claude_state},blocked},#[fg={{ .gruvbox.bright_red }}],#[fg={{ .gruvbox.bright_green }}]}}● #[default]#W #[fg={{ .gruvbox.fg4 }}]#{b:pane_current_path},#{session_name}}' \
    "run-shell '~/.config/tmux/claude-jump.sh %%'"

bind-key j choose-tree -swZ -f '#{?#{m:claude_*,#{session_name}},0,1}'

# popup windows
bind g display-popup -E -d "#{pane_current_path}" -xC -yC -w 90% -h 90% "lazygit"
bind-key t display-popup -E -w 90% -h 90% -d '#{pane_current_path}' -T 'Sesh' tv sesh

# television popups
bind-key T display-popup -E -d "#{pane_current_path}" -xC -yC -w 90% -h 90% "tv"
bind-key o display-popup -E -d "#{pane_current_path}" -xC -yC -w 90% -h 90% "tv sessionizer"
bind-key w display-popup -E -d "#{pane_current_path}" -xC -yC -w 90% -h 90% "tv tmux-sessions"
bind-key f display-popup -E -d "#{pane_current_path}" -xC -yC -w 90% -h 90% "tv open"
